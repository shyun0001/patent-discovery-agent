# ─── LLM ──────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL_PRIMARY=gpt-4o
OPENAI_MODEL_SECONDARY=gpt-4o-mini

# ─── GitHub 연동 ──────────────────────────────────────
# repo 읽기 권한이 있는 Personal Access Token
GITHUB_TOKEN=
# 데모용 기본 저장소 (선택) 예: acme-lab/model-compression
GITHUB_DEFAULT_REPO=shyun0001/patent_discovery

# ─── Google Drive 연동 ────────────────────────────────
# 서비스 계정 키(JSON) 또는 OAuth 클라이언트 시크릿(JSON). 파일 종류는 자동 판별한다.
# API 키만 있으면 링크 공개 파일만 접근 가능하다 (폴더 탐색·리비전 비교 불가).
GDRIVE_API_KEY=
GDRIVE_CREDENTIALS_PATH=data/credentials/google_credentials.json
GDRIVE_TOKEN_PATH=data/credentials/token.json
# 데모용 기본 폴더 ID (선택)
GDRIVE_DEFAULT_FOLDER_ID=

# ─── KIPRIS 선행기술 검색 ─────────────────────────────
# plus.kipris.or.kr 에서 발급받은 Service Key
KIPRIS_SERVICE_KEY=
# 유사도 평가 대상 상위 N건
KIPRIS_MAX_RESULTS=10
# true 이면 실제 호출 없이 tests/fixtures/kipris_search.xml 사용 (데모 안전장치)
KIPRIS_OFFLINE=true
